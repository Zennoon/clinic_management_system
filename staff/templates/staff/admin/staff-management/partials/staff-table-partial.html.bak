{% load humanize %}
<div id="staff-table-container" class="card flex flex-col gap-4">
  {% if staff_members %}
    <div class="flex items-center justify-between px-4 py-3 sm:px-6">
      <table class="table table-zebra table-pin-rows p-2 max-h-full overflow-scroll">
        <thead>
          <tr>
            <th>ID</th>
            <th>Username</th>
            <th>Email</th>
            <th>Role</th>
            <th>Phone</th>
            <th>Date</th>
            <th class="text-center">Actions</th>
          </tr>
        </thead>
        <tbody id="staff-table-body">
          {% for staff in staff_members %}
            {% include 'staff/admin/staff-management/partials/staff-table-row-partial.html' %}
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% else %}
    <div class="flex p-6 justify-center items-center">No staff found</div>
  {% endif %}
</div>
